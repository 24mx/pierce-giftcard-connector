# Copy to .env and fill in the bracketed values:  cp .env.template .env
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# commercetools project
# ---------------------------------------------------------------------------
CTP_PROJECT_KEY=[composable-commerce-project-key]

# API client scopes required by this connector (see connect.yaml):
#   manage_payments  manage_orders  view_sessions  view_api_clients
#   manage_checkout_payment_intents  introspect_oauth_tokens
CTP_CLIENT_ID=[composable-commerce-client-id]
CTP_CLIENT_SECRET=[composable-commerce-client-secret]

# Defaults below are for the europe-west1 region; swap the region if the project lives elsewhere.
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SESSION_URL=https://session.europe-west1.gcp.commercetools.com
CTP_CHECKOUT_URL=https://checkout.europe-west1.gcp.commercetools.com
CTP_JWKS_URL=https://mc-api.europe-west1.gcp.commercetools.com/.well-known/jwks.json
CTP_JWT_ISSUER=https://mc-api.europe-west1.gcp.commercetools.com

# ---------------------------------------------------------------------------
# Pierce loyalty backend - owner of the points ledger
# ---------------------------------------------------------------------------
# Base URL only, no trailing path: the client appends /loyalty/giftcard/*.
# The backend must run the branch that exposes /loyalty/giftcard/{balance,hold,void}.
LOYALTY_API_URL=http://localhost:[loyalty-backend-port]

# Timeout in milliseconds for every call to the loyalty backend. Keep it well under
# the checkout widget's patience - on timeout the redeem fails and no transaction is
# written, which is the only recoverable outcome.
LOYALTY_TIMEOUT_MS=5000

# Shared secret, sent as the X-Api-Key header on every call. Leave empty only against a
# backend on this same machine; anywhere the backend is reachable from outside, this is
# what stops a stranger from releasing other people's holds. In a deployment it belongs
# in securedConfiguration, never in standardConfiguration.
LOYALTY_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Port the processor listens on. Connect deploys it on 8080, which is also where the
# loyalty backend runs locally - override one of the two to run both side by side.
PORT=8080

# error | warn | info | debug
LOGGER_LEVEL=info

# Timeout in milliseconds for the /operations/status health checks.
HEALTH_CHECK_TIMEOUT=5000

# ---------------------------------------------------------------------------
# docker-compose only
# ---------------------------------------------------------------------------
# `docker-compose up` overrides these two to point at the bundled jwt-mock-server,
# so leave them commented out unless you run the processor through compose by hand.
# CTP_JWKS_URL=http://jwt-server:9000/jwt/.well-known/jwks.json
# CTP_JWT_ISSUER=https://issuer.com
