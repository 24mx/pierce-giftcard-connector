{
  "name": "enabler",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "start": "serve public -l 8080 --cors",
    "test": "jest --detectOpenHandles",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\"",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "npm run build && serve public -l 3000 --cors"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "sass": "1.102.0",
    "prettier": "^3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-css-injected-by-js": "5.0.2"
  },
  "dependencies": {
    "serve": "14.2.6"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.5",
    "brace-expansion@5": "5.0.9"
  }
}
